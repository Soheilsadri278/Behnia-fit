# ------------------------------------------------------------------
#  تنظیمات سرور بهنیا فیت
#  این فایل را به نام .env کپی کنید و مقادیر را پر کنید.
#  فایل .env هرگز کامیت نمی‌شود.
# ------------------------------------------------------------------

# پورت و آدرس عمومی
PORT=8000
SITE_URL=http://localhost:8000

# حساب مربی — فقط بار اول ساخته می‌شود
COACH_PHONE=09121234567
COACH_PASSWORD=یک-رمز-قوی-بگذارید
COACH_NAME=بهنیا

# شمارهٔ کارت برای پرداخت کارت‌به‌کارت (در صفحهٔ پرداخت نمایش داده می‌شود)
CARD_NUMBER=6037-9970-0000-0000

# درگاه زرین‌پال (اختیاری)
# تا وقتی ZARINPAL_MERCHANT خالی باشد، دکمهٔ درگاه نمایش داده نمی‌شود.
ZARINPAL_MERCHANT=
# نرخ تبدیل دلار به تومان (برای درگاه). مثلاً ۱۰۰۰۰۰ یعنی هر دلار ۱۰۰ هزار تومان
ZARINPAL_RATE=
# محیط تست: https://sandbox.zarinpal.com — محیط واقعی:
ZARINPAL_BASE=https://payment.zarinpal.com

# اگر پشت پروکسی HTTPS هستید (لیارا، کلودفلر …) این را ۱ بگذارید
TRUST_PROXY=0
